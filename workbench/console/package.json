{
  "name": "arachne-console",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "seed:demo": "node scripts/seed-native-demo.mjs",
    "seed:demo:legacy": "node scripts/seed-demo.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "package:win:installer": "node scripts/package-windows-installer.mjs",
    "verify:demo": "node tests/demo-integration.mjs",
    "verify:drawing": "node tests/drawing-integration.mjs",
    "verify:drawing-batch": "node tests/image-layer-batch-integration.mjs",
    "verify:drawing-bake": "node tests/image-layer-bake-integration.mjs",
    "verify:drawing-layout": "node tests/image-layout-integration.mjs",
    "verify:drawing-brush-view": "node tests/image-brush-view-integration.mjs",
    "verify:drawing-text": "node tests/image-text-integration.mjs",
    "verify:drawing-color": "node tests/image-color-integration.mjs",
    "verify:drawing-pen": "node tests/image-pen-integration.mjs",
    "verify:drawing-repair": "node tests/image-repair-integration.mjs",
    "verify:drawing-selection": "node tests/image-selection-integration.mjs",
    "verify:material-library": "node tests/material-library-integration.mjs",
    "verify:mesh-maps": "node tests/mesh-maps-integration.mjs",
    "verify:production": "node tests/production-workflow-integration.mjs",
    "verify:stability": "node tests/stability-workflow-integration.mjs && node tests/render-stability-integration.mjs",
    "verify:workspace": "node tests/workspace-appearance-integration.mjs",
    "verify:mac-desktop": "node tests/macos-desktop-integration.mjs",
    "verify:model-import": "node tests/model-import-integration.mjs",
    "verify:blend-migration": "node tests/blend-migration-integration.mjs"
