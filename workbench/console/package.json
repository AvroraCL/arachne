  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "playwright-core": "1.58.2",
    "polygon-clipping": "0.15.7",
    "three": "0.180.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.1",
    "xatlas-web": "0.1.0"
